# === Codex Harness ===
# Device-auth via `codex login` — no API keys needed.
CODEX_HOME=~/.codex
CODEX_TIMEOUT_SECONDS=120

# === Server ===
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173

# === Data Paths ===
DATA_DIR=./data

# === Supabase (optional — local JSON storage is used when unset) ===
# SUPABASE_URL=
# SUPABASE_ANON_KEY=
# SUPABASE_JWT_SECRET=
# SUPABASE_STORAGE_BUCKET=job-bot

# === Redis (optional — required for async workers) ===
# REDIS_URL=redis://localhost:6379/0

# === Quotas ===
MAX_UPLOAD_SIZE_MB=8
DEFAULT_SEARCH_LIMIT=20
MAX_SEARCH_LIMIT=50
AI_SCORE_LIMIT=10
